<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 can_resize="false"
 can_close="true"
 can_minimize="true"
 height="580"
 layout="topleft"
 name="avatar_lora"
 help_topic="avatar_lora"
 single_instance="true"
 title="Avatar LoRA Capture"
 width="650">

	<string name="self_suffix">(you)</string>
	<string name="info_no_avatar">No avatar selected</string>
	<string name="info_avatar">Height [HEIGHT] m &#183; Skeleton: [SKELETON]</string>
	<string name="skeleton_ok">complete</string>
	<string name="skeleton_missing">incomplete (still loading?)</string>
	<string name="total_images">[COUNT] images</string>
	<string name="status_ready">Ready. Use Preview to check framing before starting.</string>
	<string name="status_countdown">Starting in [SECONDS]...</string>
	<string name="status_capturing">Image [INDEX]/[TOTAL] &#183; [SHOT]</string>
	<string name="status_done">Done - [COUNT] images written to [DIR]</string>
	<string name="status_aborted">Capture aborted.</string>
	<string name="status_dir_failed">Could not create the output folder.</string>
	<string name="status_preview">Framing preview - the camera follows this floater.</string>
	<string name="status_measure_failed">Could not measure the avatar. Is it fully loaded?</string>
	<string name="preview_info">[INDEX]/[TOTAL] &#183; [SHOT] &#183; az [AZ]&#176; el [EL]&#176; &#183; [DIST] m</string>
	<string name="group_fullbody">Full body</string>
	<string name="group_upperbody">Upper body</string>
	<string name="group_midbody">Torso / hips</string>
	<string name="group_legs">Legs</string>
	<string name="group_head">Head</string>
	<string name="group_face">Face</string>
	<string name="group_hands">Hands</string>
	<string name="group_feet">Feet</string>
	<string name="side_left">left</string>
	<string name="side_right">right</string>

	<!-- ============================ Left column ============================ -->

	<text
	 follows="left|top"
	 font="SansSerifBold"
	 height="16"
	 layout="topleft"
	 left="10"
	 name="target_label"
	 top="10"
	 width="300">
	 Target avatar
	</text>

	<scroll_list
	 can_sort="false"
	 draw_heading="true"
	 follows="left|top"
	 height="100"
	 layout="topleft"
	 left="20"
	 multi_select="false"
	 name="avatar_list"
	 tool_tip="Avatar to capture. Your own avatar is listed first."
	 top_pad="5"
	 width="225">
		<scroll_list.columns
		 label="Nearby avatars"
		 name="name"
		 relative_width="1.0" />
	</scroll_list>

	<button
	 follows="left|top"
	 height="23"
	 label="Refresh"
	 layout="topleft"
	 left_pad="5"
	 name="refresh_avatars_btn"
	 top_delta="0"
	 width="60" />

	<text
	 follows="left|top"
	 height="16"
	 layout="topleft"
	 left="20"
	 name="avatar_info"
	 top_pad="5"
	 width="290" />

	<text
	 follows="left|top"
	 font="SansSerifBold"
	 height="16"
	 layout="topleft"
	 left="10"
	 name="shots_label"
	 top_pad="14"
	 width="300">
	 Shot set
	</text>

	<text
	 follows="left|top"
	 height="16"
	 layout="topleft"
	 left="200"
	 name="directions_label"
	 top_pad="4"
	 width="110">
	 Directions
	</text>

	<check_box
	 height="20"
	 initial_value="true"
	 label="Full body"
	 layout="topleft"
	 left="20"
	 name="shot_fullbody"
	 tool_tip="Orbit around the whole body, at every height level."
	 top_pad="2"
	 width="170" />
	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="1"
	 initial_value="8"
	 label=""
	 label_width="0"
	 layout="topleft"
	 left="200"
	 max_val="72"
	 min_val="1"
	 name="count_fullbody"
	 top_delta="0"
	 width="60" />

	<check_box
	 height="20"
	 initial_value="true"
	 label="Upper body"
	 layout="topleft"
	 left="20"
	 name="shot_upperbody"
	 top_pad="4"
	 width="170" />
	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="1"
	 initial_value="8"
	 label=""
	 label_width="0"
	 layout="topleft"
	 left="200"
	 max_val="72"
	 min_val="1"
	 name="count_upperbody"
	 top_delta="0"
	 width="60" />

	<check_box
	 height="20"
	 initial_value="true"
	 label="Torso / hips"
	 layout="topleft"
	 left="20"
	 name="shot_midbody"
	 top_pad="4"
	 width="170" />
	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="1"
	 initial_value="8"
	 label=""
	 label_width="0"
	 layout="topleft"
	 left="200"
	 max_val="72"
	 min_val="1"
	 name="count_midbody"
	 top_delta="0"
	 width="60" />

	<check_box
	 height="20"
	 initial_value="true"
	 label="Legs"
	 layout="topleft"
	 left="20"
	 name="shot_legs"
	 top_pad="4"
	 width="170" />
	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="1"
	 initial_value="8"
	 label=""
	 label_width="0"
	 layout="topleft"
	 left="200"
	 max_val="72"
	 min_val="1"
	 name="count_legs"
	 top_delta="0"
	 width="60" />

	<check_box
	 height="20"
	 initial_value="true"
	 label="Head"
	 layout="topleft"
	 left="20"
	 name="shot_head"
	 top_pad="4"
	 width="170" />
	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="1"
	 initial_value="16"
	 label=""
	 label_width="0"
	 layout="topleft"
	 left="200"
	 max_val="72"
	 min_val="1"
	 name="count_head"
	 top_delta="0"
	 width="60" />

	<check_box
	 height="20"
	 initial_value="true"
	 label="Hands / arms (per side)"
	 layout="topleft"
	 left="20"
	 name="shot_hands"
	 top_pad="4"
	 width="170" />
	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="1"
	 initial_value="3"
	 label=""
	 label_width="0"
	 layout="topleft"
	 left="200"
	 max_val="24"
	 min_val="1"
	 name="count_hands"
	 top_delta="0"
	 width="60" />

	<check_box
	 height="20"
	 initial_value="true"
	 label="Feet / legs (per side)"
	 layout="topleft"
	 left="20"
	 name="shot_feet"
	 top_pad="4"
	 width="170" />
	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="1"
	 initial_value="3"
	 label=""
	 label_width="0"
	 layout="topleft"
	 left="200"
	 max_val="24"
	 min_val="1"
	 name="count_feet"
	 top_delta="0"
	 width="60" />

	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="1"
	 initial_value="3"
	 label="Full body height levels"
	 label_width="170"
	 layout="topleft"
	 left="20"
	 max_val="9"
	 min_val="1"
	 name="fullbody_levels"
	 tool_tip="Number of camera heights for the full body orbit (level, from above, from below)."
	 top_pad="8"
	 width="240" />

	<!-- ============================ Right column =========================== -->

	<text
	 follows="left|top"
	 font="SansSerifBold"
	 height="16"
	 layout="topleft"
	 left="330"
	 name="camera_label"
	 top="10"
	 width="300">
	 Camera
	</text>

	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="1"
	 initial_value="40"
	 label="Body FOV (deg)"
	 label_width="150"
	 layout="topleft"
	 left="340"
	 max_val="90"
	 min_val="10"
	 name="fov_body"
	 tool_tip="Field of view for body shots. Wider means more perspective distortion."
	 top_pad="5"
	 width="280" />

	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="1"
	 initial_value="24"
	 label="Detail FOV (deg)"
	 label_width="150"
	 layout="topleft"
	 left="340"
	 max_val="90"
	 min_val="10"
	 name="fov_detail"
	 tool_tip="Field of view for head, hand and foot close-ups. A portrait lens keeps faces undistorted."
	 top_pad="4"
	 width="280" />

	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="1"
	 initial_value="10"
	 label="Framing margin (%)"
	 label_width="150"
	 layout="topleft"
	 left="340"
	 max_val="50"
	 min_val="0"
	 name="framing_margin"
	 top_pad="4"
	 width="280" />

	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="1"
	 initial_value="20"
	 label="Elevation high (deg)"
	 label_width="150"
	 layout="topleft"
	 left="340"
	 max_val="80"
	 min_val="0"
	 name="elevation_high"
	 top_pad="4"
	 width="280" />

	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="1"
	 initial_value="-20"
	 label="Elevation low (deg)"
	 label_width="150"
	 layout="topleft"
	 left="340"
	 max_val="0"
	 min_val="-80"
	 name="elevation_low"
	 top_pad="4"
	 width="280" />

	<text
	 follows="left|top"
	 font="SansSerifBold"
	 height="16"
	 layout="topleft"
	 left="330"
	 name="output_label"
	 top_pad="14"
	 width="300">
	 Output
	</text>

	<combo_box
	 height="23"
	 label="Resolution"
	 label_width="100"
	 layout="topleft"
	 left="340"
	 name="resolution_combo"
	 top_pad="5"
	 width="280">
		<combo_item name="1024">1024 x 1024 (SDXL / Flux)</combo_item>
		<combo_item name="768">768 x 768 (SD 1.5)</combo_item>
		<combo_item name="512">512 x 512</combo_item>
		<combo_item name="1536">1536 x 1536</combo_item>
		<combo_item name="2048">2048 x 2048</combo_item>
		<combo_item name="custom">Custom</combo_item>
	</combo_box>

	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="64"
	 initial_value="1024"
	 label="W"
	 label_width="20"
	 layout="topleft"
	 left="340"
	 max_val="8192"
	 min_val="256"
	 name="custom_width"
	 top_pad="4"
	 visible="false"
	 width="135" />
	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="64"
	 initial_value="1024"
	 label="H"
	 label_width="20"
	 layout="topleft"
	 left_pad="5"
	 max_val="8192"
	 min_val="256"
	 name="custom_height"
	 top_delta="0"
	 visible="false"
	 width="135" />

	<line_editor
	 follows="left|top"
	 height="23"
	 layout="topleft"
	 left="340"
	 name="output_dir"
	 tool_tip="Folder the dataset is written to."
	 top_pad="4"
	 width="215" />
	<button
	 follows="left|top"
	 height="23"
	 label="Browse"
	 layout="topleft"
	 left_pad="5"
	 name="browse_btn"
	 top_delta="0"
	 width="60" />

	<combo_box
	 height="23"
	 label="Folder layout"
	 label_width="100"
	 layout="topleft"
	 left="340"
	 name="folder_structure"
	 top_pad="4"
	 width="280">
		<combo_item name="flat">Flat</combo_item>
		<combo_item name="kohya">Kohya (img/&lt;repeats&gt;_&lt;trigger&gt;)</combo_item>
	</combo_box>

	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="1"
	 initial_value="20"
	 label="Repeats"
	 label_width="100"
	 layout="topleft"
	 left="340"
	 max_val="200"
	 min_val="1"
	 name="kohya_repeats"
	 tool_tip="Repeat count encoded in the Kohya folder name."
	 top_pad="4"
	 width="180" />

	<text
	 follows="left|top"
	 height="20"
	 layout="topleft"
	 left="340"
	 name="trigger_label"
	 top_pad="6"
	 width="100">
	 Trigger word
	</text>
	<line_editor
	 follows="left|top"
	 height="20"
	 layout="topleft"
	 left_pad="0"
	 name="trigger_word"
	 tool_tip="Unique token the LoRA is trained on, e.g. ohwx_avatar."
	 top_delta="0"
	 width="180" />

	<text
	 follows="left|top"
	 height="20"
	 layout="topleft"
	 left="340"
	 name="class_label"
	 top_pad="4"
	 width="100">
	 Class token
	</text>
	<line_editor
	 follows="left|top"
	 height="20"
	 layout="topleft"
	 left_pad="0"
	 name="class_token"
	 tool_tip="Class the subject belongs to, e.g. woman, man, person."
	 top_delta="0"
	 width="180" />

	<text
	 follows="left|top"
	 height="20"
	 layout="topleft"
	 left="340"
	 name="tags_label"
	 top_pad="4"
	 width="100">
	 Extra tags
	</text>
	<line_editor
	 follows="left|top"
	 height="20"
	 layout="topleft"
	 left_pad="0"
	 name="extra_tags"
	 tool_tip="Added to every caption, e.g. outfit or hair description. Separate tags with commas."
	 top_delta="0"
	 width="180" />

	<check_box
	 height="20"
	 initial_value="true"
	 label="Write caption sidecar files"
	 layout="topleft"
	 left="340"
	 name="write_captions"
	 top_pad="4"
	 width="280" />

	<check_box
	 height="20"
	 initial_value="true"
	 label="First tag in file names"
	 layout="topleft"
	 left="340"
	 name="tags_in_filename"
	 tool_tip="Puts the first extra tag into every file name, so a second series - another outfit, an open instead of a closed mouth - does not overwrite the first."
	 top_pad="4"
	 width="280" />

	<!-- ============================== Run ================================= -->

	<text
	 follows="left|top"
	 font="SansSerifBold"
	 height="16"
	 layout="topleft"
	 left="10"
	 name="run_label"
	 top="440"
	 width="300">
	 Capture
	</text>

	<text
	 follows="left|top"
	 height="16"
	 layout="topleft"
	 left="20"
	 name="total_images_result"
	 top_pad="5"
	 width="150" />
	<text
	 follows="left|top"
	 height="16"
	 layout="topleft"
	 left_pad="5"
	 name="estimated_size"
	 top_delta="0"
	 width="150" />

	<button
	 follows="left|top"
	 height="23"
	 label="&lt; Preview"
	 layout="topleft"
	 left="20"
	 name="preview_prev_btn"
	 tool_tip="Move the camera to the previous shot without capturing."
	 top_pad="5"
	 width="80" />
	<button
	 follows="left|top"
	 height="23"
	 label="Preview &gt;"
	 layout="topleft"
	 left_pad="5"
	 name="preview_next_btn"
	 tool_tip="Move the camera to the next shot without capturing."
	 top_delta="0"
	 width="80" />
	<text
	 follows="left|top"
	 height="16"
	 layout="topleft"
	 left_pad="10"
	 name="preview_label"
	 top_delta="4"
	 width="200" />

	<button
	 follows="left|top"
	 height="23"
	 label="Capture body"
	 layout="topleft"
	 left="20"
	 name="start_btn"
	 tool_tip="Run the shot set configured on the left."
	 top_pad="8"
	 width="120" />
	<button
	 follows="left|top"
	 height="23"
	 label="Capture face"
	 layout="topleft"
	 left_pad="8"
	 name="start_face_btn"
	 tool_tip="Separate close-up series of the face: 9 directions from the right profile to the left profile including exact front, at three heights (27 images). Ignores the shot set."
	 top_delta="0"
	 width="120" />
	<button
	 follows="left|top"
	 height="23"
	 label="Stop"
	 layout="topleft"
	 left_pad="8"
	 name="stop_btn"
	 top_delta="0"
	 width="70" />

	<spinner
	 decimal_digits="0"
	 height="20"
	 increment="1"
	 initial_value="3"
	 label="Start delay (s)"
	 label_width="90"
	 layout="topleft"
	 left_pad="15"
	 max_val="60"
	 min_val="0"
	 name="capture_delay"
	 tool_tip="Countdown before the first image, so you can let go of the camera."
	 top_delta="2"
	 width="150" />

	<progress_bar
	 follows="left|top"
	 height="16"
	 layout="topleft"
	 left="20"
	 name="capture_progress"
	 top_pad="8"
	 width="610" />

	<text
	 follows="left|top"
	 height="16"
	 layout="topleft"
	 left="20"
	 name="status_text"
	 top_pad="5"
	 width="610" />

</floater>
